{
  "name": "vibe-ade",
  "version": "0.5.1",
  "description": "Windows-native Development Environment",
  "main": "dist/main/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/whothemyst-byte/Vibe_ADE.git"
  },
  "author": "",
  "license": "MIT",
  "scripts": {
    "postinstall": "node scripts/patch-node-gyp-vs2026.cjs && node scripts/patch-node-pty-spectre.cjs",
    "dev": "node scripts/run-electron-vite.cjs dev",
    "build": "node scripts/run-electron-vite.cjs build",
    "dist:win": "npm run build && electron-builder --config electron-builder.yml --win nsis portable",
    "preview": "node scripts/run-electron-vite.cjs preview",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fontsource/manrope": "^5.2.8",
    "@fontsource/sora": "^5.2.8",
    "@xyflow/react": "^12.10.2",
    "electron-store": "^10.0.1",
    "electron-updater": "^6.8.3",
    "lucide-react": "^0.469.0",
    "node-pty": "^1.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "^2.1.7",
    "react-rnd": "^10.5.3",
    "uuid": "^11.0.3",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0",
    "xterm-addon-search": "^0.13.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.0",
    "clsx": "^2.1.1",
    "electron": "^42.1.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "eslint": "^9.17.0",
    "postcss": "^8.5.10",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.5"
  },
  "overrides": {
    "node-abi": "^4.31.0"
  }
